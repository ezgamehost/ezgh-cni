table inet ezgh_cni {
	set prefixes4 {
		type ipv4_addr
		flags interval
	}
	set prefixes6 {
		type ipv6_addr
		flags interval
	}
	chain forward {
		type filter hook forward priority -10; policy accept;
		iifname "ezp*" ip daddr 169.254.169.254 drop
		iifname "ezp*" ip6 daddr fd65:7a67:6800::254 drop
		iifname "ezp*" oifname != "enp2s0" oifname != "ezp*" meta nfproto ipv6 meta l4proto tcp reject with tcp reset
		iifname "ezp*" oifname != "enp2s0" oifname != "ezp*" meta nfproto ipv6 reject with icmpv6 type admin-prohibited
		oifname != "enp2s0" oifname != "ezp*" tcp flags syn tcp option maxseg size set rt mtu
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "enp2s0" return
		oifname "ezp*" return
		ip saddr @prefixes4 masquerade fully-random
	}
}
